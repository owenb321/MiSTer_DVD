nul
# .claude/: the shared agent config (skills, commands, project settings) IS tracked --
# it is part of how this project is built, and the release/merge/docs workflows live
# there. Only per-machine and runtime state stays out.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/**/*.local.*
Template_MiSTer-master/
CDi_MiSTer-main/
mpeg2fpga-orig/
prior-working-config/
ao486_MiSTer-master/
TSConf_MiSTer-master/
releases-old/

# --- Quartus build artifacts (regenerated by compile; never commit) ---
db/
incremental_db/
output_files/
qdb/
.qsys_edit/
hps_isw_handoff/
hc_output/
greybox_tmp/
*.qws
*.rpt
*.summary
*.smsg
*.qmsg
*.pin
*.jdi
*.sof
*.pof
*.sld
*.cdf
c5_pin_model_dump.txt
PLLJ_PLLSPE_INFO.txt
build.log
compile_output.log

# --- On-hardware capture artifacts (pre-release cleanup, 2026-08-23) ---
# Overlay CSV captures and the osd_read calibration frame are RAW DATA from
# specific debugging sessions, regenerated by tools/osd_read.py on demand. The
# analyses that used them live in docs/ and stand on their own.
/*.csv
/osd_calibrated.png

# --- OS / editor junk ---
.DS_Store

# --- Simulation artifacts (compiled by iverilog; regenerated) ---
*.vvp
*.vcd
*.lxt
*.ppm
*.mpg
bench/**/*_sim
bench/dvd/*.log
mpeg2_sim
sim_mpg
bench/dvd/chain_*
bench/dvd/prefetch_results.txt
bench/dvd/prefetch_sweep_fine.txt

# --- Built cores (huge; keep out of git — use build_release.sh, archive to releases-old/) ---
releases/*.rbf
releases/*.rbf.json
releases/*.zip
!releases/.gitkeep

# --- Test media (copyrighted VOB extracts — keep out of the repo) ---
bench/dvd/test_vobs/

# AC-3 decoder verification artifacts (ported from MiSTer_AC3)
bench/ac3/obj/
bench/ac3/obj_cosim/
tools/streams/

build_id.v

# Local notifier endpoint (Discord webhook / ntfy topic) — secret, never commit
tools/.notify_url
tools/__pycache__/
__pycache__/
*.pyc

# Phase-2 conformance golden-trace binaries (built by tools/build_dvd_trace.sh)
tools/bin/
bench/dvd/test_mp2/

# --- User manual build output (MkDocs; regenerated by mkdocs build / CI) ---
# NOTE: `site/` is the manual's SOURCE and IS tracked. The stock MkDocs
# .gitignore snippet says `site/` because that is MkDocs' DEFAULT output dir —
# do NOT add it here. mkdocs.yml overrides site_dir to .site-build precisely so
# the two can never be confused.
.site-build/
.cache/

# --- Local Python venvs (mkdocs preview, tooling) ---
.venv/
venv/
bench/dvd/csync_ref_gen.v

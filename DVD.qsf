set_global_assignment -name TOP_LEVEL_ENTITY sys_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 17.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "01:23:45  FEBRUARY 10, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP "-40"
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256

# Search Path for Include Files
# dvd/mem_override is listed FIRST so its mem_codes.v (MP@ML map, VBUF at 3.5 MiB)
# overrides rtl/mpeg2/mem_codes.v (MP@HL, VBUF at 14 MiB = unbacked f2sdram). The
# override dir holds only mem_codes.v so nothing else is shadowed.
set_global_assignment -name SEARCH_PATH dvd/mem_override
set_global_assignment -name SEARCH_PATH rtl/mpeg2
# dvd/ac3 holds the in-fabric AC-3 decoder; SEARCH_PATH lets its modules `include
# the ac3_*.svh table/define headers.
set_global_assignment -name SEARCH_PATH dvd/ac3

# Files
set_global_assignment -name SYSTEMVERILOG_FILE dvd/emu.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/ps_demux.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/disp_hstretch.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/disp_vscale.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/crt_ov_map.sv
# dual-raster analog output: progressive -> 15 kHz 480i/576i second raster (VGA2_*)
set_global_assignment -name SYSTEMVERILOG_FILE dvd/re_interlace.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/cc_line21.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/ps_stream_fifo.sv
# AC-3 reframer: re-frame demuxed AC-3 on 0x0B77 boundaries so audio_ring drops
# whole AC-3 frames (clean) instead of PES chunks (pop). See dvd/ac3_reframer.sv.
set_global_assignment -name SYSTEMVERILOG_FILE dvd/ac3_reframer.sv
# DTS reframer: re-frame demuxed DTS on 0x7FFE8001 core-sync boundaries (chained
# after ac3_reframer) so audio_ring/iec61937_wrap see whole DTS frames.
set_global_assignment -name SYSTEMVERILOG_FILE dvd/dts_reframer.sv
# MP2 reframer: re-frame demuxed MPEG-1 Layer II (stream_id 0xC0+n, T_MP2) on
# real frame boundaries (chained after dts_reframer). See docs/mpeg1.md A.3.
set_global_assignment -name SYSTEMVERILOG_FILE dvd/mp2_reframer.sv
# MP2 (MPEG-1 Layer II) fabric decoder — the DVD-spec "MPEG audio" format.
# Bit-exact vs tools/mp2_ref.py; ROMs generated by tools/gen_mp2_tables.py.
set_global_assignment -name SYSTEMVERILOG_FILE dvd/mp2/mp2_decode.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/audio_ring.sv
# In-fabric audio decode: audio_ring -> dvd_audio_decode (AC-3 + LPCM) -> AUDIO_L/R.
# (The old DDR3-ring + HPS-daemon audio path was removed; ddr_arb is kept for the
# decoder DDR path.)
set_global_assignment -name SYSTEMVERILOG_FILE dvd/dvd_audio_decode.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/lpcm_unpack.sv
# IEC 61937 S/PDIF bitstream passthrough (Path B): iec61937_wrap wraps undecoded
# AC-3/DTS frames into 61937 bursts; spdif_pass is the biphase encoder (a copy of
# sys/spdif.v with the non-PCM channel-status bit set). See docs/iec61937.md.
set_global_assignment -name SYSTEMVERILOG_FILE dvd/spdif_pass.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/iec61937_wrap.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/av_sync.sv
# Reference-read run-ahead prefetch (O[18]): single-bitstream A/B gate for the deepened
# fwd/bwd motion-comp reference data fifos. See dvd/ref_dta_gate.sv / docs/motcomp_throughput.md.
set_global_assignment -name SYSTEMVERILOG_FILE dvd/ref_dta_gate.sv

set_global_assignment -name SYSTEMVERILOG_FILE dvd/ac3/ac3_front.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/ac3/ac3_parse.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/ac3/bit_fifo.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/ac3/bit_reader.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/ac3/sync_crc.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/ac3/bsi_parse.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/ac3/audblk_parse.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/ac3/exponent_decode.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/ac3/bit_allocation.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/ac3/mantissa_dequant.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/ac3/imdct_512.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/ac3/pcm_out.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/ddr_arb.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/vidfeed_cdc.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/debug_overlay.sv
# DVD-FORK (subpicture/subtitle O15 + O[26:24]): SPU decoder + reusable alpha blend.
# See docs/subpicture.md.
set_global_assignment -name SYSTEMVERILOG_FILE dvd/spu_decode.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/subpic_blend.sv
# DVD-FORK (Phase-1 disc menus): PGC palette (IFO @164) YCbCr->RGB LUT.
set_global_assignment -name SYSTEMVERILOG_FILE dvd/pgc_palette.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/nav_pci.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/nav_dsi.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/scrub_ctrl.sv
# DVD-FORK (Phase-11 transport HUD): text-plane/glyph-ROM status renderer,
# muxed into the subpic_blend register stage. ROM init = dvd/hud_font.mem
# (generated by tools/hud_font.py). See docs/transport_hud.md.
set_global_assignment -name SYSTEMVERILOG_FILE dvd/transport_hud.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/seek_bar.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/idle_logo.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/bcd_time_add.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/dvd_vm.sv
# DVD-FORK (frame-drop governor O[19]): catch-up credit controller. See
# dvd/frame_drop_ctl.sv / docs/motcomp_throughput.md.
set_global_assignment -name SYSTEMVERILOG_FILE dvd/frame_drop_ctl.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/mem_shim.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/mem_shim_burst.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/sys_pll.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mpg_streamer.sv
set_global_assignment -name SYSTEMVERILOG_FILE dvd/dvd_iso_reader.sv




# Logic Modules (Headers excluded, found via SEARCH_PATH)
set_global_assignment -name VERILOG_FILE rtl/mpeg2/framestore.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/framestore_request.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/framestore_response.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/fwft.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/getbits.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/idct.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/iquant.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/mem_addr.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/mixer.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/motcomp.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/motcomp_addrgen.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/motcomp_dcttype.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/motcomp_motvec.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/motcomp_picbuf.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/motcomp_recon.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/mpeg2video.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/osd.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/pixel_queue.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/probe.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/read_write.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/regfile.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/resample.v
# 256-line strobe fix: dvd/ copy of resample_addrgen with the saturating frame-top
# index (replaces rtl/mpeg2/resample_addrgen.v). See docs/history.md.
set_global_assignment -name VERILOG_FILE dvd/resample_addrgen.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/resample_bilinear.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/resample_dta.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/reset.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/rld.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/syncgen.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/syncgen_intf.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/synchronizer.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/vbuf.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/vld.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/watchdog.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/wrappers.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/xfifo_sc.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/xilinx_fifo_dc.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/xilinx_fifo.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/xilinx_fifo_sc.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/xilinx_fifo144.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/xilinx_fifo216.v
set_global_assignment -name VERILOG_FILE rtl/mpeg2/yuv2rgb.v

# Pin and IO assignments are sourced from standard MiSTer TCL files

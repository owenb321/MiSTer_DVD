	(text "J1 = USB 3.0 Standard-A PLUG - this board is the dongle."
		(exclude_from_sim no)
		(at 40 124 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "658fa662-6fab-42a6-a88e-6c67bf7334eb")
	)
	(text "Contacts 2,3,5,6,7,8 are FPGA signals; 1=+5V, 4=GND, 9=+3V3."
		(exclude_from_sim no)
		(at 40 130 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "608c51d9-5355-4812-b926-570b22950e9c")
	)
	(text "Which USER_IO[] index lands on which contact is a property of the"
		(exclude_from_sim no)
		(at 40 136 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "b055cc65-ecd7-4eef-83d1-69e56ba286e4")
	)
	(text "IO BOARD. The core assigns its indices to match - so the signal"
		(exclude_from_sim no)
		(at 40 142 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "17f03703-cc27-4e61-acfe-3b79a0295f8c")
	)
	(text "contacts are interchangeable and only 1/4/9 must be verified."
		(exclude_from_sim no)
		(at 40 148 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "ce61f878-289f-49f9-ba19-8ba84a6da6d0")
	)
	(text "HOST_3V3 is left unloaded on purpose: we regulate our own 3V3."

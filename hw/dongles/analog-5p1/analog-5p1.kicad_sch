	(text "PCM5102A output is GROUND-CENTRED - the internal charge pump"
		(exclude_from_sim no)
		(at 55 548 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "6cfa7334-be6e-4337-ac4e-86fad2cecd20")
	)
	(text "(C_4 flying cap across CAPP/CAPM, C_5 on VNEG) generates the"
		(exclude_from_sim no)
		(at 55 554 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "15647779-8d09-4662-8d3f-0fb68d296328")
	)
	(text "negative rail - so NO DC-blocking capacitors are needed or"
		(exclude_from_sim no)
		(at 55 560 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "ac1bc4a7-81c5-4755-896c-53b40eed1402")
	)
	(text "wanted. The output R/C is RF rejection and short-circuit"
		(exclude_from_sim no)
		(at 55 566 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "6bba1b54-001c-4178-9932-d5413c64f5c7")
	)
	(text "protection only, not a reconstruction filter."
		(exclude_from_sim no)
		(at 55 572 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "27408edd-6186-4fca-b473-2afef861a77f")
	)
	(text "SCK tied to GND selects BCK-PLL mode, so no MCLK wire is"
		(exclude_from_sim no)
		(at 430 548 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "23f9a0a5-6434-4021-9267-02e246715340")
	)
	(text "needed and the user port has a contact to spare for EN."
		(exclude_from_sim no)
		(at 430 554 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "55e85c2e-9022-4f36-8d56-878db79e162b")
	)
	(text "Channel order is the PC analog convention, so a stock"
		(exclude_from_sim no)
		(at 430 560 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "b4f75c1b-3792-4a21-9ad0-6a650a681d91")
	)
	(text "3x3.5mm-to-6xRCA cable maps straight through. An HDMI sink"
		(exclude_from_sim no)
		(at 430 566 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "1fd8d1bc-51d7-4f86-888a-8683d1425227")
	)
